NOTION_TOKEN=
NOTION_DATABASE_ID=
# 複数data sourceを含むDBでは必須
NOTION_DATA_SOURCE_ID=
NOTION_SUMMARY_PROPERTY=summary
NOTION_TAG_PROPERTY=tag
NOTION_SUMMARY_TIME_PROPERTY=summary_time
# openai/<model>, anthropic/<model>, gemini/<model>, xai/<model>,
# openrouter/<provider>/<model>, openai_compatible/<model>
LLM_MODEL=gemini/gemini-2.5-flash
OPENAI_API_KEY=
# openai_compatible 利用時: /chat/completions を含まないベースURL (例: http://host:8000/v1)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
# 未設定ならMarkdown出力をスキップ。Dockerで出力する場合は /output
MARKDOWN_OUTPUT_DIR=
TIMEZONE=Asia/Tokyo
RECENT_ARTICLE_COUNT=100
LLM_CHUNK_CHARS=12000
# 推論トークンも含む出力上限。length終了時は1回だけ2倍にして再試行
LLM_MAX_TOKENS=8192
# 空欄ならモデル標準。gpt-5-nanoのみminimalを自動指定
LLM_REASONING_EFFORT=
